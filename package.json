{
  "name": "glb-doctor",
  "version": "0.1.1",
  "description": "Diagnose glTF/GLB files: scene stats, texture sizes, wasted bytes and actionable warnings. Zero dependencies, works in the browser and in Node.",
  "type": "module",
  "license": "MIT",
  "author": "Denis Pilich",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DenisPilich/3DModels.git"
  },
  "homepage": "https://github.com/DenisPilich/3DModels#readme",
  "bugs": {
    "url": "https://github.com/DenisPilich/3DModels/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "gltf",
    "glb",
    "3d",
    "diagnostics",
    "optimization",
    "webgl",
    "threejs"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "glb-doctor": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "build:demo": "vite build",
    "preview": "vite preview",
    "cli": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sample": "node scripts/make-sample.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "three": "^0.186.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
